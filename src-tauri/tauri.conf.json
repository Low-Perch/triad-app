{
  "productName": "triad",
  "version": "0.0.0",
  "identifier": "com.triad.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "triad",
        "width": 400,
        "height": 500,
        "fullscreen": false,
        "resizable": false,
        "visible": false,
        "hiddenTitle": true,
        "decorations": false,
        "focus": true,
        "transparent": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
