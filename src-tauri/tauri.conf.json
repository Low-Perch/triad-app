{
  "productName": "triad",
  "version": "0.1.0",
  "identifier": "com.triad.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Triad",
        "width": 320,
        "height": 500,
        "fullscreen": false,
        "resizable": false,
        "visible": true,
        "decorations": true,
        "focus": true,
        "transparent": false,
        "skipTaskbar": false,
        "alwaysOnTop": false
      }
    ],
    "security": {}
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMjc5ODkxOTQyRTgzMEYKUldRUGd5NlVrWmduejB6Z2tjdXFLSDRvQ3JpMmlLdm50VVdjQXZMM216RkdqalRuZWNjV1MwR2YK",
      "endpoints": [
        "https://github.com/Low-Perch/triad-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
